############################################################
# ResumeOS Environment Configuration
############################################################

#########################
# Application
#########################

APP_NAME=ResumeOS
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

HOST=0.0.0.0
PORT=8000

#########################
# Security
#########################

SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

#########################
# Database
#########################

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resumeos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resumeos

#########################
# OpenAI
#########################

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.5

#########################
# File Uploads
#########################

UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=25

#########################
# Resume Storage
#########################

RESUME_STORAGE_PATH=storage/resumes
GENERATED_RESUME_PATH=storage/generated

#########################
# Logging
#########################

LOG_LEVEL=INFO
LOG_FILE=logs/resumeos.log

#########################
# CORS
#########################

CORS_ORIGINS=http://localhost:5173

#########################
# Redis
#########################

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

#########################
# AWS S3 (Future)
#########################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=